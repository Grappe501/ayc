{
  "name": "ayc-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:migrate": "node --experimental-strip-types server/db/migrate.ts",
    "db:seed-teams": "node --experimental-strip-types server/db/seed-teams.ts",
    "db:seed-roster": "node --experimental-strip-types server/db/seed-leadership-roster.ts",
    "db:seed-hierarchy": "node --experimental-strip-types server/db/seed-hierarchy.ts",
    "db:seed-location-boards": "node --experimental-strip-types server/db/seed-location-boards.ts"
  },
  "dependencies": {
    "@netlify/database": "^1.1.0",
    "@supabase/supabase-js": "^2.111.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@netlify/functions": "^3.1.2",
    "@types/node": "^22.15.32",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
