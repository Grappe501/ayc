# Server-only Postgres connection (never expose to the browser bundle).
# On Netlify, NETLIFY_DB_URL is injected automatically when @netlify/database is installed.
DATABASE_URL=
# NETLIFY_DB_URL=

# Lead Organizer master key — unlocks every board (alias: AYC_LEADER_WRITE_SECRET).
AYC_MASTER_KEY=
AYC_LEADER_WRITE_SECRET=

# Category Campaign Lead keys — each unlocks that category board.
# Social Media also opens Graphic Design. Optional dedicated GD key lands on the GD board.
AYC_KEY_ORGANIZER=
AYC_KEY_VOTER_REGISTRATION=
AYC_KEY_SOCIAL_MEDIA=
AYC_KEY_GRAPHIC_DESIGN=
AYC_KEY_EVENTS=
AYC_KEY_OUTREACH=

# Segment Lead Organizer keys — land on their segment shells; also open statewide Leader Board.
AYC_KEY_HIGH_SCHOOL=
AYC_KEY_WORKING_CLASS=

AYC_ENVIRONMENT=development
AYC_SITE_NAME=Arkansas Youth Coalition
AYC_ALLOWED_ORIGIN=
LOG_LEVEL=info

# Playwright smoke (optional). Prefer AYC_E2E_MASTER_KEY so local app secrets stay separate.
# PLAYWRIGHT_BASE_URL=https://arkansasyouth.netlify.app
# AYC_E2E_MASTER_KEY=
# On this workstation keep browsers on H: — PLAYWRIGHT_BROWSERS_PATH=H:\playwright-browsers

# Personal login (Supabase Auth) — server-only service role; never expose to Vite.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Browser-safe (anon key only):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# After a database URL is available:
#   npm run db:migrate
#   npm run db:seed-teams
#   npm run db:seed-roster
#   npm run db:seed-hierarchy
#   npm run db:seed-location-boards
